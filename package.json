{
	"name": "oaiproxy",
	"publisher": "lqdflying",
	"displayName": "OAIProxy",
	"description": "Azure Foundry/OpenAI/LiteLLM/Ollama/Anthropic/Gemini/xAI provider for Copilot Chat, with Azure Foundry, OpenAI, OpenAI Codex OAuth, TokenRouter, Anthropic, Fireworks, Kimi, DeepSeek, Z.AI GLM, Xiaomi MiMo, MiniMax, and Grok OAuth/API-key presets",
	"icon": "assets/icon.png",
	"keywords": [
		"ai",
		"chat",
		"copilot",
		"github-copilot",
		"language-model",
		"llm",
		"openai",
		"tokenrouter",
		"kimi",
		"moonshot",
		"deepseek",
		"fireworks",
		"zai",
		"zhipu",
		"glm",
		"mimo",
		"xiaomi",
		"minimax",
		"ollama",
		"anthropic",
		"claude",
		"gemini",
		"xai",
		"grok",
		"codex",
		"openai-oauth",
		"litellm",
		"openai-compatible",
		"openai-responses",
		"git-commit",
		"thinking"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/lqdflying/OAIProxy"
	},
	"version": "0.1.47",
	"engines": {
		"vscode": "^1.120.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"activationEvents": [
		"onStartupFinished",
		"onLanguageModelChatProvider:oaiproxy",
		"onCommand:oaiproxy.setApikey",
		"onCommand:oaiproxy.setProviderApikey",
		"onCommand:oaiproxy.loginXaiOAuth",
		"onCommand:oaiproxy.logoutXaiOAuth",
		"onCommand:oaiproxy.loginOpenAIOAuth",
		"onCommand:oaiproxy.logoutOpenAIOAuth",
		"onCommand:oaiproxy.openConfig",
		"onCommand:oaiproxy.generateGitCommitMessage",
		"onCommand:oaiproxy.abortGitCommitMessage"
	],
	"badges": [
		{
			"url": "https://img.shields.io/github/stars/lqdflying/OAIProxy?style=social",
			"description": "Star OAIProxy on Github",
			"href": "https://github.com/lqdflying/OAIProxy"
		}
	],
	"bugs": {
		"url": "https://github.com/lqdflying/OAIProxy/issues"
	},
	"license": "MIT",
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "oaiproxy",
				"displayName": "OAIProxy",
				"managementCommand": "oaiproxy.setApikey"
			}
		],
		"commands": [
			{
				"command": "oaiproxy.setApikey",
				"category": "OAIProxy",
				"title": "%command.setApikey.title%"
			},
			{
				"command": "oaiproxy.setProviderApikey",
				"category": "OAIProxy",
				"title": "%command.setProviderApikey.title%"
			},
			{
				"command": "oaiproxy.loginXaiOAuth",
				"category": "OAIProxy",
				"title": "%command.loginXaiOAuth.title%"
			},
			{
				"command": "oaiproxy.logoutXaiOAuth",
				"category": "OAIProxy",
				"title": "%command.logoutXaiOAuth.title%"
			},
			{
				"command": "oaiproxy.loginOpenAIOAuth",
				"category": "OAIProxy",
				"title": "%command.loginOpenAIOAuth.title%"
			},
			{
				"command": "oaiproxy.logoutOpenAIOAuth",
				"category": "OAIProxy",
				"title": "%command.logoutOpenAIOAuth.title%"
			},
			{
				"command": "oaiproxy.openConfig",
				"category": "OAIProxy",
				"title": "%command.openConfig.title%"
			},
			{
				"command": "oaiproxy.checkProviderUsage",
				"category": "OAIProxy",
				"title": "%command.checkProviderUsage.title%"
			},
			{
				"command": "oaiproxy.generateGitCommitMessage",
				"title": "%command.generateGitCommitMessage.title%",
				"category": "OAIProxy",
				"icon": "$(wand)"
			},
			{
				"command": "oaiproxy.abortGitCommitMessage",
				"title": "%command.abortGitCommitMessage.title%",
				"category": "OAIProxy",
				"icon": "$(debug-stop)"
			}
		],
		"menus": {
			"scm/title": [
				{
					"command": "oaiproxy.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !oaiproxy.isGeneratingCommit"
				},
				{
					"command": "oaiproxy.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && oaiproxy.isGeneratingCommit"
				}
			],
			"commandPalette": [
				{
					"command": "oaiproxy.generateGitCommitMessage",
					"when": "config.git.enabled && !oaiproxy.isGeneratingCommit"
				},
				{
					"command": "oaiproxy.abortGitCommitMessage",
					"when": "config.git.enabled && oaiproxy.isGeneratingCommit"
				}
			]
		},
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"oaicopilot.logLevel": {
					"type": "string",
					"default": "off",
					"enum": [
						"off",
						"debug",
						"info",
						"warn",
						"error"
					],
					"description": "%config.logLevel.description%"
				},
				"oaicopilot.baseUrl": {
					"type": "string",
					"default": "https://router.huggingface.co/v1",
					"description": "%config.baseUrl.description%"
				},
				"oaicopilot.models": {
					"type": "array",
					"default": [],
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"description": "%config.models.id.description%"
							},
							"_comment": {
								"type": "string",
								"description": "%config.models._comment.description%"
							},
							"displayName": {
								"type": "string",
								"description": "%config.models.displayName.description%"
							},
							"configId": {
								"type": "string",
								"description": "%config.models.configId.description%"
							},
							"owned_by": {
								"type": "string",
								"description": "%config.models.owned_by.description%"
							},
							"authMode": {
								"type": "string",
								"enum": ["api-key", "oauth"],
								"description": "%config.models.authMode.description%"
							},
							"provider": {
								"type": "string",
								"description": "%config.models.provider.description%"
							},
							"provide": {
								"type": "string",
								"description": "%config.models.provide.description%"
							},
							"family": {
								"type": "string",
								"description": "%config.models.family.description%"
							},
							"baseUrl": {
								"type": "string",
								"description": "%config.models.baseUrl.description%"
							},
							"context_length": {
								"type": "number",
								"default": 128000,
								"minimum": 1000,
								"maximum": 10000000,
								"description": "%config.models.context_length.description%"
							},
							"max_input_tokens": {
								"type": "number",
								"minimum": 1,
								"maximum": 10000000,
								"description": "%config.models.max_input_tokens.description%"
							},
							"vision": {
								"type": "boolean",
								"default": false,
								"description": "%config.models.vision.description%"
							},
							"toolCalling": {
								"type": "boolean",
								"default": true,
								"description": "%config.models.toolCalling.description%"
							},
							"max_tokens": {
								"type": "number",
								"default": 4096,
								"minimum": 1,
								"maximum": 10000000,
								"description": "%config.models.max_tokens.description%"
							},
							"max_completion_tokens": {
								"type": "number",
								"default": 4096,
								"minimum": 1,
								"maximum": 10000000,
								"description": "%config.models.max_completion_tokens.description%"
							},
							"reasoning_effort": {
								"type": "string",
								"default": "medium",
								"enum": [
									"max",
									"xhigh",
									"high",
									"medium",
									"low",
									"minimal",
									"none"
								],
								"description": "%config.models.reasoning_effort.description%"
							},
							"supports_reasoning_effort": {
								"type": "boolean",
								"default": false,
								"description": "%config.models.supports_reasoning_effort.description%"
							},
							"supported_reasoning_efforts": {
								"type": "array",
								"description": "%config.models.supported_reasoning_efforts.description%",
								"items": {
									"type": "string"
								}
							},
							"default_reasoning_effort": {
								"type": "string",
								"description": "%config.models.default_reasoning_effort.description%"
							},
							"thinking": {
								"type": "object",
								"description": "%config.models.thinking.description%",
								"properties": {
									"type": {
										"type": "string",
										"enum": [
											"enabled",
											"disabled",
											"adaptive"
										],
										"description": "%config.models.thinking.type.description%"
									},
									"clear_thinking": {
										"type": "boolean",
										"description": "%config.models.thinking.clear_thinking.description%"
									}
								}
							},
							"enable_thinking": {
								"type": "boolean",
								"default": false,
								"description": "%config.models.enable_thinking.description%"
							},
							"thinking_budget": {
								"type": "number",
								"default": 128,
								"minimum": 128,
								"maximum": 10000000,
								"description": "%config.models.thinking_budget.description%"
							},
							"temperature": {
								"type": "number",
								"default": 0,
								"minimum": 0,
								"maximum": 2,
								"description": "%config.models.temperature.description%"
							},
							"top_p": {
								"type": "number",
								"default": 1,
								"minimum": 0,
								"maximum": 1,
								"description": "%config.models.top_p.description%"
							},
							"top_k": {
								"type": "number",
								"default": 50,
								"minimum": 1,
								"description": "%config.models.top_k.description%"
							},
							"min_p": {
								"type": "number",
								"default": 0,
								"minimum": 0,
								"maximum": 1,
								"description": "%config.models.min_p.description%"
							},
							"frequency_penalty": {
								"type": "number",
								"default": 0,
								"minimum": -2,
								"maximum": 2,
								"description": "%config.models.frequency_penalty.description%"
							},
							"presence_penalty": {
								"type": "number",
								"default": 0,
								"minimum": -2,
								"maximum": 2,
								"description": "%config.models.presence_penalty.description%"
							},
							"repetition_penalty": {
								"type": "number",
								"default": 0,
								"minimum": 0,
								"maximum": 2,
								"description": "%config.models.repetition_penalty.description%"
							},
							"reasoning": {
								"type": "object",
								"default": {
									"effort": "medium"
								},
								"properties": {
									"effort": {
										"type": "string",
										"default": "medium",
										"enum": [
											"max",
											"xhigh",
											"high",
											"medium",
											"low",
											"minimal",
											"auto"
										],
										"description": "%config.models.reasoning.effort.description%"
									},
									"exclude": {
										"type": "boolean",
										"default": false,
										"description": "%config.models.reasoning.exclude.description%"
									},
									"max_tokens": {
										"type": "number",
										"default": 2000,
										"minimum": 1,
										"description": "%config.models.reasoning.max_tokens.description%"
									},
									"enabled": {
										"type": "boolean",
										"default": true,
										"description": "%config.models.reasoning.enabled.description%"
									}
								},
								"description": "%config.models.reasoning.description%"
							},
							"prompt_cache": {
								"type": "object",
								"description": "%config.models.prompt_cache.description%",
								"properties": {
									"enabled": {
										"type": "boolean",
										"default": true,
										"description": "%config.models.prompt_cache.enabled.description%"
									},
									"key": {
										"type": "string",
										"description": "%config.models.prompt_cache.key.description%"
									},
									"retention": {
										"type": "string",
										"enum": [
											"in_memory",
											"24h"
										],
										"description": "%config.models.prompt_cache.retention.description%"
									},
									"anthropic": {
										"type": "object",
										"description": "%config.models.prompt_cache.anthropic.description%",
										"properties": {
											"enabled": {
												"type": "boolean",
												"default": false,
												"description": "%config.models.prompt_cache.anthropic.enabled.description%"
											},
											"ttl": {
												"type": "string",
												"enum": [
													"5m",
													"1h"
												],
												"default": "5m",
												"description": "%config.models.prompt_cache.anthropic.ttl.description%"
											},
											"cache_system": {
												"type": "boolean",
												"default": true,
												"description": "%config.models.prompt_cache.anthropic.cache_system.description%"
											},
											"cache_tools": {
												"type": "boolean",
												"default": true,
												"description": "%config.models.prompt_cache.anthropic.cache_tools.description%"
											}
										}
									}
								}
							},
							"extra": {
								"type": "object",
								"description": "%config.models.extra.description%"
							},
							"extra_body": {
								"type": "object",
								"description": "%config.models.extra_body.description%"
							},
							"headers": {
								"type": "object",
								"additionalProperties": {
									"type": "string"
								},
								"description": "%config.models.headers.description%"
							},
							"include_reasoning_in_request": {
								"type": "boolean",
								"default": false,
								"description": "%config.models.include_reasoning_in_request.description%"
							},
							"apiMode": {
								"type": "string",
								"enum": [
									"openai",
									"azure-foundry",
									"litellm",
									"openai-responses",
									"ollama",
									"anthropic",
									"gemini"
								],
								"default": "openai",
								"description": "%config.models.apiMode.description%"
							},
							"useForCommitGeneration": {
								"type": "boolean",
								"default": false,
								"description": "%config.models.useForCommitGeneration.description%"
							},
							"delay": {
								"type": "number",
								"default": 0,
								"minimum": 0,
								"description": "%config.models.delay.description%"
							}
						},
						"required": [
							"id"
						],
						"anyOf": [
							{
								"required": [
									"owned_by"
								]
							},
							{
								"required": [
									"provider"
								]
							},
							{
								"required": [
									"provide"
								]
							}
						]
					},
					"description": "%config.models.description%"
				},
				"oaicopilot.retry": {
					"type": "object",
					"default": {
						"enabled": true,
						"max_attempts": 3,
						"interval_ms": 1000,
						"status_codes": []
					},
					"properties": {
						"enabled": {
							"type": "boolean",
							"default": true,
							"description": "%config.retry.enabled.description%"
						},
						"max_attempts": {
							"type": "number",
							"default": 3,
							"minimum": 1,
							"description": "%config.retry.max_attempts.description%"
						},
						"interval_ms": {
							"type": "number",
							"default": 1000,
							"minimum": 1,
							"description": "%config.retry.interval_ms.description%"
						},
						"status_codes": {
							"type": "array",
							"items": {
								"type": "number"
							},
							"description": "%config.retry.status_codes.description%"
						}
					},
					"description": "%config.retry.description%"
				},
				"oaicopilot.delay": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "%config.delay.description%"
				},
				"oaicopilot.commitLanguage": {
					"type": "string",
					"default": "English",
					"enum": [
						"English",
						"French",
						"Italian",
						"German",
						"Spanish",
						"Russian",
						"Chinese (Simplified)",
						"Chinese (Traditional)",
						"Japanese",
						"Korean",
						"Czech",
						"Portuguese (Brazil)",
						"Turkish",
						"Polish"
					],
					"description": "%config.commitLanguage.description%"
				},
				"oaicopilot.commitMessagePrompt": {
					"type": "string",
					"default": "",
					"description": "%config.commitMessagePrompt.description%"
				},
				"oaicopilot.readFileLines": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 10000,
					"description": "%config.readFileLines.description%"
				},
				"oaicopilot.tokenEstimation": {
					"type": "object",
					"default": {
						"charsPerToken": 4,
						"nonAsciiTokensPerChar": 1,
						"maxSerializedPartChars": 200000,
						"bridgeTokens": 8192,
						"calibration": "observe",
						"image": {
							"strategy": "auto",
							"profile": "auto",
							"fixedTokens": 8192,
							"fallbackTokens": 8192,
							"areaDivisor": 750,
							"maxLongEdge": 2576,
							"maxTokensPerImage": 8192
						},
						"perModel": {}
					},
					"additionalProperties": false,
					"properties": {
						"charsPerToken": {
							"type": "number",
							"minimum": 0.1,
							"maximum": 100,
							"description": "%config.tokenEstimation.charsPerToken.description%"
						},
						"nonAsciiTokensPerChar": {
							"type": "number",
							"minimum": 0.1,
							"maximum": 100
						},
						"maxSerializedPartChars": {
							"type": "integer",
							"minimum": 64,
							"maximum": 1000000,
							"description": "%config.tokenEstimation.maxSerializedPartChars.description%"
						},
						"bridgeTokens": {
							"type": "integer",
							"minimum": 1,
							"maximum": 1000000,
							"description": "%config.tokenEstimation.bridgeTokens.description%"
						},
						"calibration": {
							"type": "string",
							"enum": [
								"observe",
								"adaptive"
							],
							"description": "%config.tokenEstimation.calibration.description%"
						},
						"image": {
							"type": "object",
							"additionalProperties": false,
							"properties": {
								"strategy": {
									"type": "string",
									"enum": [
										"auto",
										"fixed",
										"area"
									],
									"description": "%config.tokenEstimation.image.strategy.description%"
								},
								"profile": {
									"type": "string",
									"enum": [
										"auto",
										"openai-patches",
										"openai-tiles",
										"claude-standard",
										"claude-high",
										"unknown"
									]
								},
								"fixedTokens": {
									"type": "integer",
									"minimum": 1,
									"maximum": 1000000
								},
								"fallbackTokens": {
									"type": "integer",
									"minimum": 1,
									"maximum": 1000000
								},
								"areaDivisor": {
									"type": "number",
									"minimum": 0.01,
									"maximum": 1000000
								},
								"maxLongEdge": {
									"type": "number",
									"minimum": 1,
									"maximum": 1000000
								},
								"maxTokensPerImage": {
									"type": "integer",
									"minimum": 1,
									"maximum": 1000000
								}
							}
						},
						"perModel": {
							"type": "object",
							"description": "%config.tokenEstimation.perModel.description%",
							"additionalProperties": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"charsPerToken": {
										"type": "number",
										"minimum": 0.1,
										"maximum": 100,
										"description": "%config.tokenEstimation.charsPerToken.description%"
									},
									"nonAsciiTokensPerChar": {
										"type": "number",
										"minimum": 0.1,
										"maximum": 100
									},
									"maxSerializedPartChars": {
										"type": "integer",
										"minimum": 64,
										"maximum": 1000000,
										"description": "%config.tokenEstimation.maxSerializedPartChars.description%"
									},
									"bridgeTokens": {
										"type": "integer",
										"minimum": 1,
										"maximum": 1000000,
										"description": "%config.tokenEstimation.bridgeTokens.description%"
									},
									"calibration": {
										"type": "string",
										"enum": [
											"observe",
											"adaptive"
										],
										"description": "%config.tokenEstimation.calibration.description%"
									},
									"image": {
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"strategy": {
												"type": "string",
												"enum": [
													"auto",
													"fixed",
													"area"
												],
												"description": "%config.tokenEstimation.image.strategy.description%"
											},
											"profile": {
												"type": "string",
												"enum": [
													"auto",
													"openai-patches",
													"openai-tiles",
													"claude-standard",
													"claude-high",
													"unknown"
												]
											},
											"fixedTokens": {
												"type": "integer",
												"minimum": 1,
												"maximum": 1000000
											},
											"fallbackTokens": {
												"type": "integer",
												"minimum": 1,
												"maximum": 1000000
											},
											"areaDivisor": {
												"type": "number",
												"minimum": 0.01,
												"maximum": 1000000
											},
											"maxLongEdge": {
												"type": "number",
												"minimum": 1,
												"maximum": 1000000
											},
											"maxTokensPerImage": {
												"type": "integer",
												"minimum": 1,
												"maximum": 1000000
											}
										}
									}
								}
							}
						}
					},
					"description": "%config.tokenEstimation.description%"
				},
				"oaicopilot.debug.tokenBreakdown": {
					"type": "boolean",
					"default": false,
					"description": "%config.debug.tokenBreakdown.description%"
				},
				"oaicopilot.visionBridgeEnabled": {
					"type": "boolean",
					"default": true,
					"description": "%config.visionBridgeEnabled.description%"
				},
				"oaicopilot.visionBridgeModel": {
					"type": "string",
					"default": "",
					"description": "%config.visionBridgeModel.description%"
				},
				"oaicopilot.visionBridgePrompt": {
					"type": "string",
					"default": "",
					"description": "%config.visionBridgePrompt.description%"
				}
			}
		}
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"download-api": "dts dev && mv vscode.proposed.*.ts src",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"format": "prettier --write .",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && vscode-test",
		"build": "/usr/bin/env PATH=/usr/bin:/bin:/usr/sbin:/sbin:/home/opc/.local/bin:/home/opc/.bun/bin /usr/bin/npx --yes @vscode/vsce package -o oaiproxy-${npm_package_version}.vsix"
	},
	"dependencies": {
		"@microsoft/tiktokenizer": "^1.0.10"
	},
